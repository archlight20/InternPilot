<% layout('layouts/boilerplate') %>

<main class="mx-auto max-w-5xl space-y-6 px-3 py-6 sm:px-4">
    <header class="flex flex-col gap-3 border-b border-slate-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <a href="/candidate/applications" class="text-xs font-semibold text-indigo-700 hover:underline">&larr; Back to My Applications</a>
            <p class="mt-3 text-xs font-semibold uppercase tracking-[0.16em] text-indigo-600">Application record</p>
            <h1 class="mt-1 text-2xl font-bold text-slate-900"><%= (internship && internship.title) || 'Submitted application' %></h1>
            <p class="mt-1 text-sm text-slate-500">Review the exact materials you shared with the hiring team.</p>
        </div>
        <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700"><%= application.status || 'Submitted' %></span>
    </header>

    <%- include('../partials/application-kit-summary', { applicationKit: application.applicationKit }) %>
</main>
