<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Portfolio Restricted' %> - InternPilot</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>

<body class="bg-slate-50 min-h-screen flex flex-col justify-between">
    <!-- Top Tricolor Accent Line -->
    <div class="h-1.5 w-full bg-gradient-to-r from-orange-500 via-white to-emerald-600"></div>

    <div class="flex-1 flex items-center justify-center p-6">
        <div class="max-w-md w-full bg-white rounded-2xl border border-slate-200 shadow-xl p-8 text-center space-y-6">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-600 text-3xl shadow-xs">
                <i class="ph-bold ph-lock-key"></i>
            </div>

            <div class="space-y-2">
                <h1 class="text-2xl font-bold text-slate-900">Portfolio Is Private</h1>
                <p class="text-sm text-slate-500 leading-relaxed">
                    <%= typeof reason !== 'undefined' && reason ? reason : "This candidate has set their verified portfolio to private." %>
                </p>
            </div>

            <div class="bg-slate-50 rounded-xl p-4 border border-slate-100 text-xs text-slate-600 flex items-center gap-3 text-left">
                <i class="ph-bold ph-shield-check text-indigo-600 text-xl shrink-0"></i>
                <span>Candidate portfolios respect personal privacy controls. Verified credentials remain secure.</span>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 pt-2">
                <a href="/"
                    class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold transition-colors shadow-xs">
                    <i class="ph-bold ph-arrow-left"></i>
                    Back to Home
                </a>
                <% if (!currentUser) { %>
                    <a href="/auth/login"
                        class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold transition-colors shadow-xs">
                        <i class="ph-bold ph-sign-in"></i>
                        Log In
                    </a>
                <% } %>
            </div>
        </div>
    </div>

    <footer class="py-4 text-center text-xs text-slate-400">
        InternPilot • Official Internship Portal
    </footer>
</body>
</html>
