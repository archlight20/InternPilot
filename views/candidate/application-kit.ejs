<% layout('layouts/boilerplate') %>
<%
    const availableResumes = Array.isArray(resumeVersions) ? resumeVersions : [];
    const projects = Array.isArray(candidate && candidate.projects) ? candidate.projects : [];
    const certifications = Array.isArray(candidate && candidate.certifications) ? candidate.certifications : [];
    const skills = Array.isArray(candidateSkills) ? candidateSkills : [];
    const listingQuestions = Array.isArray(questions) ? questions : [];
    const defaultResumeId = (availableResumes.find(resume => resume.isDefault) || availableResumes[0] || {}).sourceId || '';
%>

<main class="mx-auto max-w-5xl space-y-6 px-3 py-6 sm:px-4">
    <header class="flex flex-col gap-4 border-b border-slate-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <a href="/internships/<%= internship._id %>" class="text-xs font-semibold text-indigo-700 hover:underline">&larr; Back to opportunity</a>
            <p class="mt-3 text-xs font-semibold uppercase tracking-[0.16em] text-indigo-600">Application Kit</p>
            <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-900"><%= internship.title %></h1>
            <p class="mt-1 text-sm text-slate-500">Choose exactly what the hiring team will receive. You can review the full submission before sending it.</p>
        </div>
        <div class="rounded-xl border border-indigo-100 bg-indigo-50 px-4 py-3 text-xs text-indigo-800">
            <p class="font-bold"><%= internship.companyName || 'Company' %></p>
            <p class="mt-0.5"><%= internship.sector || 'Internship opportunity' %></p>
        </div>
    </header>

    <form action="/internships/<%= internship._id %>/application-kit/preview" method="POST" class="space-y-5">
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
            <div class="flex items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-700"><i class="ph-bold ph-file-text" aria-hidden="true"></i></span>
                <div>
                    <h2 class="text-base font-bold text-slate-900">1. Select a resume</h2>
                    <p class="mt-1 text-xs text-slate-500">A resume is optional, but selected files are frozen into the final submission.</p>
                </div>
            </div>
            <% if (availableResumes.length) { %>
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                    <% availableResumes.forEach(resume => { %>
                        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-4 transition-colors hover:border-indigo-300 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50/50">
                            <input type="radio" name="resumeVersionId" value="<%= resume.sourceId %>" <%= resume.sourceId === defaultResumeId ? 'checked' : '' %> class="mt-1 h-4 w-4 border-slate-300 text-indigo-600 focus:ring-indigo-500">
                            <span class="min-w-0"><span class="block truncate text-sm font-semibold text-slate-800"><%= resume.label %></span><span class="mt-0.5 block truncate text-xs text-slate-500"><%= resume.fileName || 'Resume file' %></span><% if (resume.isDefault) { %><span class="mt-2 inline-flex rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-bold text-indigo-700">Default</span><% } %></span>
                        </label>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="mt-4 rounded-xl border border-dashed border-amber-300 bg-amber-50 px-4 py-3 text-xs text-amber-800">No resume version is available. You may continue without one, or <a href="/candidate/profile" class="font-bold underline">upload a resume on your profile</a> first.</div>
            <% } %>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
            <div class="flex items-start gap-3"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-700"><i class="ph-bold ph-folder-open" aria-hidden="true"></i></span><div><h2 class="text-base font-bold text-slate-900">2. Highlight relevant work</h2><p class="mt-1 text-xs text-slate-500">Select projects and certifications most relevant to this role.</p></div></div>
            <div class="mt-4 grid gap-5 lg:grid-cols-2">
                <div><h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Projects</h3><% if (projects.length) { %><div class="mt-2 space-y-2"><% projects.forEach(project => { %><label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-3 hover:border-indigo-300 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50/50"><input type="checkbox" name="projectIds" value="<%= project._id %>" class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"><span><span class="block text-sm font-semibold text-slate-800"><%= project.title %></span><span class="mt-0.5 block text-xs text-slate-500 line-clamp-2"><%= project.description || 'No description added' %></span></span></label><% }) %></div><% } else { %><p class="mt-2 text-xs text-slate-500">No projects on your profile.</p><% } %></div>
                <div><h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Certifications</h3><% if (certifications.length) { %><div class="mt-2 space-y-2"><% certifications.forEach(certification => { %><label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-3 hover:border-indigo-300 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50/50"><input type="checkbox" name="certificationIds" value="<%= certification._id %>" class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"><span><span class="block text-sm font-semibold text-slate-800"><%= certification.name %></span><span class="mt-0.5 block text-xs text-slate-500"><%= certification.issuer || 'Issuer not specified' %></span></span></label><% }) %></div><% } else { %><p class="mt-2 text-xs text-slate-500">No certifications on your profile.</p><% } %></div>
            </div>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
            <div class="flex items-start gap-3"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-700"><i class="ph-bold ph-sparkle" aria-hidden="true"></i></span><div><h2 class="text-base font-bold text-slate-900">3. Highlight your skills</h2><p class="mt-1 text-xs text-slate-500">Only the skills selected here are shared in this tailored submission.</p></div></div>
            <% if (skills.length) { %><div class="mt-4 flex flex-wrap gap-2"><% skills.forEach(skill => { %><label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-indigo-300 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-700"><input type="checkbox" name="skillNames" value="<%= skill.name %>" class="h-3.5 w-3.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"><span><%= skill.name %> <span class="font-normal text-slate-500">· <%= skill.proficiency %></span></span></label><% }) %></div><% } else { %><p class="mt-3 text-xs text-slate-500">No skills on your profile. You can add them later from <a class="font-semibold text-indigo-700 hover:underline" href="/candidate/profile">your profile</a>.</p><% } %>
        </section>

        <% if (listingQuestions.length) { %>
            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                <div class="flex items-start gap-3"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-700"><i class="ph-bold ph-chat-text" aria-hidden="true"></i></span><div><h2 class="text-base font-bold text-slate-900">4. Answer company questions</h2><p class="mt-1 text-xs text-slate-500">Required responses are marked with an asterisk.</p></div></div>
                <div class="mt-5 space-y-5"><% listingQuestions.forEach((question, index) => { %><div><label for="answer-<%= question.id %>" class="block text-sm font-semibold text-slate-800"><span class="mr-1 text-slate-400"><%= index + 1 %>.</span><%= question.prompt %><% if (question.required) { %><span class="ml-1 text-rose-600" aria-label="Required">*</span><% } %></label><textarea id="answer-<%= question.id %>" name="answers[<%= question.id %>]" rows="4" maxlength="<%= question.maxLength || 2000 %>" <%= question.required ? 'required' : '' %> class="mt-2 w-full resize-y rounded-xl border border-slate-200 px-3 py-2.5 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" placeholder="Write your response here"></textarea><p class="mt-1 text-[11px] text-slate-400">Up to <%= question.maxLength || 2000 %> characters</p></div><% }) %></div>
            </section>
        <% } %>

        <div class="sticky bottom-3 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-lg backdrop-blur sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-slate-500">Nothing is submitted yet. Review your choices on the next page.</p>
            <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-700 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-indigo-800 focus:outline-none focus:ring-4 focus:ring-indigo-200">Preview application <i class="ph-bold ph-arrow-right" aria-hidden="true"></i></button>
        </div>
    </form>
</main>
