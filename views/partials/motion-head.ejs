<%# Motion layer and UI refresh (#211): page transitions, toasts, reveals, card tilt and the refreshed look. %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="/css/motion-ui.css">
<link rel="stylesheet" href="/css/ui-refresh.css">
<script>
    (function () {
        var html = document.documentElement;
        // The refreshed look is for the app pages; the landing page keeps its own design (#142).
        html.setAttribute('data-ui', location.pathname === '/' ? 'landing' : 'app');
        // Content marked data-animate stays hidden only until it animates in. If
        // the animation script can't load in time, show everything anyway.
        try {
            if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            html.classList.add('motion-pending');
            setTimeout(function () {
                if (!window.__ipMotionReady) html.classList.remove('motion-pending');
            }, 3500);
        } catch (err) {}
    })();
</script>
<script>
    // Both scripts run before Tailwind's CDN script in the page layout. Tailwind
    // therefore generates `dark:` utilities only for an explicit html.dark class,
    // instead of automatically following the operating-system preference.
    window.tailwind = window.tailwind || {};
    window.tailwind.config = Object.assign({}, window.tailwind.config, { darkMode: 'class' });

    // Apply the saved (or system) preference before the first paint so dark-mode
    // visitors do not see a flash of the light header and page background.
    (function bootstrapTheme() {
        var mode = 'system';
        try {
            var stored = window.localStorage.getItem('internpilot:theme');
            if (['light', 'dark', 'system'].includes(stored)) mode = stored;
        } catch (error) {
            // Storage can be unavailable in privacy-restricted browsers.
        }

        var systemDark = Boolean(
            window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
        );
        var isDark = mode === 'dark' || (mode === 'system' && systemDark);
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.setAttribute('data-theme', mode);
    })();
</script>
<script src="/js/motion-ui.js" defer></script>
