<script>
    (function () {
        // Applies the candidate filters without a full page reload. The server
        // renders the filtered list; this fetches the same URL, swaps the
        // [data-live-region] blocks and keeps the address bar in sync. Without
        // JavaScript the form still works as a normal GET.
        const form = document.querySelector('[data-candidate-filters]');
        if (!form || !window.fetch || !window.DOMParser || !window.history) return;

        const BASE = form.getAttribute('action');
        const LISTS = ['skills', 'qualification', 'location', 'status'];
        let controller = null;
        let timer = null;

        const results = () => document.querySelector('[data-live-region="results"]');

        const readState = () => {
            const region = results();
            try { return JSON.parse(region && region.dataset.state ? region.dataset.state : '{}'); } catch (e) { return {}; }
        };

        // Lists go out as repeated keys, the same shape the form submits
        // natively, so a value like "Pune, Maharashtra" keeps its comma.
        const urlFromForm = () => {
            const params = new URLSearchParams();
            for (const [key, raw] of new FormData(form).entries()) {
                const value = String(raw).trim();
                if (!value) continue;
                if (key === 'minMatch' && Number(value) === 0) continue;
                if (LISTS.includes(key)) params.append(key, value);
                else params.set(key, value);
            }
            const qs = params.toString();
            return qs ? BASE + '?' + qs : BASE;
        };

        const updateSummaries = () => {
            form.querySelectorAll('[data-filter-dropdown]').forEach(dd => {
                const label = dd.querySelector('[data-dropdown-summary]');
                if (!label) return;
                const n = dd.querySelectorAll('input[type="checkbox"]:checked').length;
                label.textContent = n ? label.dataset.label + ' (' + n + ')' : label.dataset.label + ': any';
            });
            const range = form.elements.minMatch;
            const output = form.querySelector('[data-match-output]');
            if (range && output) output.textContent = Number(range.value) ? range.value + '%+' : 'Any';
        };

        // Match the form to what the server applied, e.g. after Back or a chip removal.
        const syncForm = (state) => {
            LISTS.forEach(key => {
                const wanted = (state[key] || []).map(v => String(v).toLowerCase());
                form.querySelectorAll('input[name="' + key + '"]').forEach(box => {
                    box.checked = wanted.includes(box.value.toLowerCase());
                });
            });
            if (form.elements.experience) form.elements.experience.value = state.experience || '';
            if (form.elements.minMatch) form.elements.minMatch.value = state.minMatch || 0;
            updateSummaries();
        };

        // The page's own search and proficiency filters hide cards client-side.
        // Run them again on the new cards, even with an empty search box, so a
        // chosen proficiency level still applies after a filter change.
        const reapplySearch = () => {
            const search = document.getElementById('candidateSearch');
            if (search) search.dispatchEvent(new Event('input', { bubbles: true }));
        };

        const setBusy = (busy) => {
            const region = results();
            if (!region) return;
            region.setAttribute('aria-busy', busy ? 'true' : 'false');
            region.classList.toggle('opacity-50', busy);
            region.classList.toggle('pointer-events-none', busy);
        };

        const load = async (url, { push = true } = {}) => {
            if (controller) controller.abort();
            controller = new AbortController();
            setBusy(true);
            try {
                const res = await fetch(url, {
                    headers: { Accept: 'text/html', 'X-Requested-With': 'fetch' },
                    credentials: 'same-origin',
                    signal: controller.signal
                });
                if (!res.ok) throw new Error('HTTP ' + res.status);

                const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
                if (!doc.querySelector('[data-live-region="results"]')) throw new Error('Unexpected response');

                document.querySelectorAll('[data-live-region]').forEach(el => {
                    const next = doc.querySelector('[data-live-region="' + el.dataset.liveRegion + '"]');
                    if (next) el.replaceWith(next);
                });

                if (push) history.pushState({ candidateFilters: true }, '', url);
                syncForm(readState());
                reapplySearch();
            } catch (err) {
                if (err.name === 'AbortError') return;
                window.location.assign(url);
            } finally {
                setBusy(false);
            }
        };

        const scheduleApply = (delay) => {
            clearTimeout(timer);
            timer = setTimeout(() => load(urlFromForm()), delay);
        };

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            clearTimeout(timer);
            load(urlFromForm());
        });

        form.addEventListener('change', (e) => {
            if (e.target.matches('[data-option-search]')) return;
            updateSummaries();
            // The slider applies when released; checkboxes and selects straight away.
            scheduleApply(e.target.type === 'range' ? 0 : 150);
        });
        form.addEventListener('input', (e) => {
            if (e.target.type === 'range') updateSummaries();
        });

        // Chips and "Clear all" are links back to this page; load them in place.
        document.addEventListener('click', (e) => {
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            const link = e.target.closest('a[href]');
            if (!link || link.target === '_blank') return;
            const url = new URL(link.getAttribute('href'), window.location.href);
            if (url.origin !== window.location.origin || url.pathname !== BASE) return;
            e.preventDefault();
            load(url.pathname + url.search);
        });

        window.addEventListener('popstate', () => {
            load(window.location.pathname + window.location.search, { push: false });
        });

        // Dropdowns: filter long option lists, close on outside click or Escape.
        form.querySelectorAll('[data-filter-dropdown]').forEach(dd => {
            const search = dd.querySelector('[data-option-search]');
            if (search) {
                search.addEventListener('input', () => {
                    const term = search.value.trim().toLowerCase();
                    dd.querySelectorAll('[data-option]').forEach(opt => {
                        opt.classList.toggle('hidden', Boolean(term) && !opt.dataset.option.includes(term));
                    });
                });
                search.addEventListener('keydown', (e) => { if (e.key === 'Enter') e.preventDefault(); });
            }
            dd.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') { dd.removeAttribute('open'); dd.querySelector('summary').focus(); }
            });
        });
        document.addEventListener('click', (e) => {
            form.querySelectorAll('[data-filter-dropdown][open]').forEach(dd => {
                if (!dd.contains(e.target)) dd.removeAttribute('open');
            });
        });

        history.replaceState({ candidateFilters: true }, '', window.location.href);
        syncForm(readState());
    })();
</script>
