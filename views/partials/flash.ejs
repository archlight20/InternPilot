<% 
const successMessages = (typeof success_msg !== 'undefined' && success_msg) ? (Array.isArray(success_msg) ? success_msg : [success_msg]).filter(Boolean) : [];
const errorMessages = (typeof error_msg !== 'undefined' && error_msg) ? (Array.isArray(error_msg) ? error_msg : [error_msg]).filter(Boolean) : [];
const passportErrors = (typeof error !== 'undefined' && error) ? (Array.isArray(error) ? error : [error]).filter(Boolean) : [];
const allErrors = [...errorMessages, ...passportErrors];
%>

<% if (successMessages.length > 0) { %>
    <div class="space-y-2 mb-6">
        <% successMessages.forEach(msg => { %>
            <div data-flash-alert class="flex items-center justify-between p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl shadow-sm transition-all" role="alert">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 shrink-0">
                        <i class="ph-bold ph-check text-base"></i>
                    </div>
                    <span class="text-xs sm:text-sm font-medium"><%= msg %></span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 p-1 rounded-md transition-colors" aria-label="Close">
                    <i class="ph-bold ph-x text-sm"></i>
                </button>
            </div>
        <% }) %>
    </div>
<% } %>

<% if (allErrors.length > 0) { %>
    <div class="space-y-2 mb-6">
        <% allErrors.forEach(msg => { %>
            <div data-flash-alert class="flex items-center justify-between p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl shadow-sm transition-all" role="alert">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 shrink-0">
                        <i class="ph-bold ph-warning-circle text-base"></i>
                    </div>
                    <span class="text-xs sm:text-sm font-medium"><%= msg %></span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 p-1 rounded-md transition-colors" aria-label="Close">
                    <i class="ph-bold ph-x text-sm"></i>
                </button>
            </div>
        <% }) %>
    </div>
<% } %>

<script>
    (function () {
        const alerts = document.querySelectorAll('[data-flash-alert]');
        alerts.forEach(function (alert) {
            setTimeout(function () {
                if (alert && alert.parentElement) {
                    alert.style.transition = 'opacity 0.4s ease-out, transform 0.4s ease-out';
                    alert.style.opacity = '0';
                    alert.style.transform = 'translateY(-6px)';
                    setTimeout(function () {
                        if (alert.parentElement) alert.remove();
                    }, 400);
                }
            }, 6000);
        });
    })();
</script>
