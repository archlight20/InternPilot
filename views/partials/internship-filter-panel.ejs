<%
    // Read the render local directly: the parent's `query` alias is a local
    // variable in its own template function and is not visible from an include.
    const panelState = typeof queryState !== 'undefined' && queryState ? queryState : {};
    const chosenSkills = Array.isArray(panelState.skills) ? panelState.skills : [];
    const chosenSkillKeys = chosenSkills.map(s => s.toLowerCase());
    const chosenDurations = Array.isArray(panelState.duration) ? panelState.duration : [];
    const skillList = typeof skillOptions !== 'undefined' && Array.isArray(skillOptions) ? skillOptions : [];
    const buckets = typeof durationBuckets !== 'undefined' && Array.isArray(durationBuckets) ? durationBuckets : [];
    // Chosen skills first, so they stay visible without scrolling the list.
    const orderedSkills = skillList.slice().sort((a, b) =>
        Number(chosenSkillKeys.includes(b.toLowerCase())) - Number(chosenSkillKeys.includes(a.toLowerCase())));
%>
<div class="space-y-4" data-filter-panel>
    <!-- Skills: multi-select with its own search box -->
    <div class="space-y-1.5">
        <label class="block text-xs font-bold text-slate-700">Required Skills</label>
        <details class="group relative" data-skills-dropdown>
            <summary class="list-none w-full flex items-center justify-between px-3 py-2 text-xs border border-slate-200 rounded-xl bg-slate-50 hover:bg-white cursor-pointer select-none">
                <span class="flex items-center gap-2 text-slate-700">
                    <i class="ph-bold ph-code text-slate-400 text-sm" aria-hidden="true"></i>
                    <span data-skills-summary><%= chosenSkills.length ? `Skills (${chosenSkills.length} selected)` : 'Skills: any' %></span>
                </span>
                <i class="ph-bold ph-caret-down text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"></i>
            </summary>

            <div class="absolute z-30 mt-1 w-full bg-white border border-slate-200 rounded-xl shadow-lg p-2.5">
                <% if (skillList.length) { %>
                    <input type="search" placeholder="Find a skill..." data-skills-search aria-label="Find a skill"
                        class="w-full px-2.5 py-1.5 mb-2 text-xs border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    <div class="max-h-48 overflow-y-auto space-y-0.5 pr-1" role="group" aria-label="Skills">
                        <% orderedSkills.forEach(skill => { %>
                            <label class="flex items-center gap-2 px-1.5 py-1 rounded hover:bg-slate-50 text-xs text-slate-700 cursor-pointer" data-skill-option="<%= skill.toLowerCase() %>">
                                <input type="checkbox" name="skills" value="<%= skill %>"
                                    <%= chosenSkillKeys.includes(skill.toLowerCase()) ? 'checked' : '' %>
                                    class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
                                <span class="truncate"><%= skill %></span>
                            </label>
                        <% }) %>
                    </div>
                    <p class="hidden text-[11px] text-slate-400 italic px-1.5 py-1" data-skills-empty>No skill matches that.</p>
                <% } else { %>
                    <p class="text-[11px] text-slate-400 italic px-1.5 py-1">No listings have skills yet.</p>
                <% } %>
            </div>
        </details>
    </div>

    <!-- Stipend range -->
    <div class="space-y-1.5">
        <label class="block text-xs font-bold text-slate-700">Monthly Stipend (₹)</label>
        <div class="flex items-center gap-2">
            <label class="sr-only" for="minStipendInput">Minimum stipend</label>
            <div class="relative flex-1">
                <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none">₹</span>
                <input type="number" id="minStipendInput" name="minStipend" min="0" step="500" inputmode="numeric"
                    value="<%= panelState.minStipend || '' %>" placeholder="Min"
                    class="w-full pl-6 pr-2 py-2 text-xs border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-slate-50 focus:bg-white transition-colors">
            </div>
            <span class="text-slate-400 text-xs font-medium" aria-hidden="true">to</span>
            <label class="sr-only" for="maxStipendInput">Maximum stipend</label>
            <div class="relative flex-1">
                <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none">₹</span>
                <input type="number" id="maxStipendInput" name="maxStipend" min="0" step="500" inputmode="numeric"
                    value="<%= panelState.maxStipend || '' %>" placeholder="Max"
                    class="w-full pl-6 pr-2 py-2 text-xs border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-slate-50 focus:bg-white transition-colors">
            </div>
        </div>
    </div>

    <!-- Duration buckets -->
    <div class="space-y-1.5">
        <label class="block text-xs font-bold text-slate-700">Duration</label>
        <fieldset class="flex flex-wrap items-center gap-1.5">
            <legend class="sr-only">Duration</legend>
            <% buckets.forEach(bucket => { %>
                <label class="cursor-pointer">
                    <input type="checkbox" name="duration" value="<%= bucket.key %>" class="peer sr-only"
                        <%= chosenDurations.includes(bucket.key) ? 'checked' : '' %>>
                    <span class="inline-block px-2.5 py-1.5 text-[11px] font-semibold rounded-lg border border-slate-200 bg-slate-50 text-slate-600 transition-colors peer-checked:bg-indigo-600 peer-checked:border-indigo-600 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-600">
                        <%= bucket.label %>
                    </span>
                </label>
            <% }) %>
        </fieldset>
    </div>
</div>
