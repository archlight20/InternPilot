<%
    const chips = typeof activeFilters !== 'undefined' && Array.isArray(activeFilters) ? activeFilters : [];
    const clearUrl = typeof clearFiltersUrl !== 'undefined' && clearFiltersUrl ? clearFiltersUrl : '/internships';
%>
<% if (chips.length) { %>
    <div class="flex flex-wrap items-center gap-2" aria-label="Active filters">
        <span class="text-xs font-semibold text-slate-600">
            <span class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 mr-1 rounded-full bg-indigo-600 text-white text-[11px] font-bold tabular-nums"><%= chips.length %></span>
            <%= chips.length === 1 ? 'filter applied' : 'filters applied' %>
        </span>

        <% chips.forEach(chip => { %>
            <a href="<%= chip.href %>" data-filter-link
                class="inline-flex items-center gap-1.5 pl-2.5 pr-1.5 py-1 text-xs font-medium rounded-full bg-indigo-50 text-indigo-800 border border-indigo-100 hover:bg-indigo-100 transition-colors"
                aria-label="Remove filter <%= chip.label %>">
                <%= chip.label %>
                <i class="ph-bold ph-x text-[10px] text-indigo-500" aria-hidden="true"></i>
            </a>
        <% }) %>

        <a href="<%= clearUrl %>" data-filter-link
            class="text-xs font-semibold text-slate-500 hover:text-rose-600 underline underline-offset-2 ml-1">
            Clear all
        </a>
    </div>
<% } %>
