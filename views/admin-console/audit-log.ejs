<% layout('layouts/boilerplate') %>
<div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)]"><%- include('partials/sidebar', { section: 'audit' }) %><section class="min-w-0"><header class="mb-5"><p class="text-xs font-bold uppercase tracking-wider text-indigo-600">Admin console</p><h1 class="text-3xl font-bold text-slate-900">Audit log</h1><p class="mt-1 text-sm text-slate-500">The 200 most recent console actions.</p></header><div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-5 py-3">When</th><th class="px-5 py-3">Actor</th><th class="px-5 py-3">Action</th><th class="px-5 py-3">Reason</th></tr></thead><tbody class="divide-y divide-slate-100"><% if (entries.length) { entries.forEach(entry => { %><tr><td class="px-5 py-3 whitespace-nowrap text-slate-500"><%= new Date(entry.createdAt).toLocaleString('en-IN') %></td><td class="px-5 py-3"><p class="font-semibold"><%= entry.actor?.name || 'Deleted admin' %></p><p class="text-xs text-slate-500"><%= entry.actor?.email || '' %></p></td><td class="px-5 py-3 font-bold text-slate-700"><%= (entry.action || 'UNKNOWN').replaceAll('_', ' ') %></td><td class="px-5 py-3 text-slate-600"><%= entry.reason || '—' %></td></tr><% }); } else { %><tr><td colspan="4" class="px-5 py-8 text-center text-slate-500">No console actions recorded.</td></tr><% } %></tbody></table></div></section></div>
