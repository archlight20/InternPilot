<% layout('layouts/boilerplate') %>
<div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)]"><%- include('partials/sidebar', { section: 'applications' }) %><section class="min-w-0"><header class="mb-5"><p class="text-xs font-bold uppercase tracking-wider text-indigo-600">Admin console</p><h1 class="text-3xl font-bold text-slate-900">Applications</h1></header>
<form method="GET" class="mb-5 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:grid-cols-3"><label class="text-xs font-bold text-slate-600">Search<input name="search" value="<%= filters.search %>" placeholder="Candidate, listing, or company" class="mt-1 w-full rounded-lg border-slate-300 text-sm" /></label><label class="text-xs font-bold text-slate-600">Status<select name="status" class="mt-1 w-full rounded-lg border-slate-300 text-sm"><option value="">All statuses</option><% statuses.forEach(status => { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select></label><div class="flex items-end gap-2"><button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-bold text-white">Filter</button><a href="/admin/console/export/applications?<%= new URLSearchParams(filters).toString() %>" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700">CSV</a></div></form>
<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-5 py-3">Candidate</th><th class="px-5 py-3">Listing</th><th class="px-5 py-3">Status</th><th class="px-5 py-3">Applied</th></tr></thead><tbody class="divide-y divide-slate-100"><% if (applications.length) { applications.forEach(application => { %><tr><td class="px-5 py-3"><p class="font-bold"><%= application.candidate?.name || 'Deleted candidate' %></p><p class="text-xs text-slate-500"><%= application.candidate?.email || '' %></p></td><td class="px-5 py-3"><p class="font-semibold"><%= application.internship?.title || 'Deleted listing' %></p><p class="text-xs text-slate-500"><%= application.internship?.companyName || '' %></p></td><td class="px-5 py-3"><span class="rounded-full bg-indigo-50 px-2 py-1 text-xs font-bold text-indigo-700"><%= application.status === 'pending' ? 'Submitted' : application.status %></span></td><td class="px-5 py-3 text-slate-500"><%= new Date(application.appliedAt).toLocaleDateString('en-IN') %></td></tr><% }); } else { %><tr><td colspan="4" class="px-5 py-8 text-center text-slate-500">No applications match these filters.</td></tr><% } %></tbody></table></div></section></div>
