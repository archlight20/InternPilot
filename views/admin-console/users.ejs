<% layout('layouts/boilerplate') %>
<div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)]"><%- include('partials/sidebar', { section: 'users' }) %><section class="min-w-0"><header class="mb-5"><p class="text-xs font-bold uppercase tracking-wider text-indigo-600">Admin console</p><h1 class="text-3xl font-bold text-slate-900">Users</h1></header>
<form method="GET" class="mb-5 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:grid-cols-4"><label class="text-xs font-bold text-slate-600">Search name or email<input name="search" value="<%= filters.search %>" class="mt-1 w-full rounded-lg border-slate-300 text-sm" /></label><label class="text-xs font-bold text-slate-600">Role<select name="role" class="mt-1 w-full rounded-lg border-slate-300 text-sm"><option value="">All roles</option><% roles.forEach(role => { %><option value="<%= role %>" <%= filters.role === role ? 'selected' : '' %>><%= role %></option><% }) %></select></label><label class="text-xs font-bold text-slate-600">Status<select name="status" class="mt-1 w-full rounded-lg border-slate-300 text-sm"><option value="">All</option><option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option><option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option></select></label><div class="flex items-end gap-2"><button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-bold text-white hover:bg-indigo-700">Filter</button><a href="/admin/console/export/users?<%= new URLSearchParams(filters).toString() %>" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700">CSV</a></div></form>
<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-5 py-3">User</th><th class="px-5 py-3">Role</th><th class="px-5 py-3">Status</th><th class="px-5 py-3">Joined</th></tr></thead><tbody class="divide-y divide-slate-100"><% if (users.length) { users.forEach(user => { %><tr><td class="px-5 py-3"><a class="font-bold text-indigo-700 hover:underline" href="/admin/console/users/<%= user._id %>"><%= user.name %></a><p class="text-xs text-slate-500"><%= user.email %></p></td><td class="px-5 py-3 capitalize"><%= user.role.replace('_', ' ') %></td><td class="px-5 py-3"><span class="rounded-full px-2 py-1 text-xs font-bold <%= user.consoleStatus === 'suspended' ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-700' %>"><%= user.consoleStatus %></span></td><td class="px-5 py-3 text-slate-500"><%= new Date(user.createdAt).toLocaleDateString('en-IN') %></td></tr><% }); } else { %><tr><td colspan="4" class="px-5 py-8 text-center text-slate-500">No users match these filters.</td></tr><% } %></tbody></table></div></section></div>
