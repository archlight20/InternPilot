<aside class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm lg:sticky lg:top-24 lg:h-fit">
    <p class="px-3 pb-2 pt-1 text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Admin console</p>
    <% const links = [
        ['overview', '/admin/console', 'SquaresFour', 'Overview'],
        ['users', '/admin/console/users', 'UsersThree', 'Users'],
        ['listings', '/admin/console/listings', 'ShieldWarning', 'Listing moderation'],
        ['applications', '/admin/console/applications', 'Files', 'Applications'],
        ['announcements', '/admin/console/announcements', 'MegaphoneSimple', 'Announcements'],
        ['audit', '/admin/console/audit-log', 'ClipboardText', 'Audit log']
    ]; %>
    <nav aria-label="Admin console" class="grid gap-1 sm:grid-cols-2 lg:block">
        <% links.forEach(([key, href, icon, label]) => { %>
            <a href="<%= href %>" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-semibold transition <%= section === key ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-indigo-700' %>">
                <i class="ph-bold ph-<%= icon.replace(/[A-Z]/g, letter => `-${letter.toLowerCase()}`) %>" aria-hidden="true"></i><%= label %>
            </a>
        <% }) %>
    </nav>
    <a href="/admin/dashboard" class="mt-3 block border-t border-slate-100 px-3 pt-3 text-xs font-semibold text-slate-500 hover:text-indigo-700">← Legacy dashboard</a>
</aside>
