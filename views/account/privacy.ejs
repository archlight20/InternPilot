<% layout('layouts/boilerplate') %>

<div class="max-w-4xl mx-auto px-4 py-8 space-y-8">
    <!-- Breadcrumb & Back Link -->
    <div class="flex items-center justify-between">
        <a href="<%= user.role === 'candidate' ? '/candidate/profile' : (['company', 'recruiter', 'hiring_manager'].includes(user.role) ? '/company/profile' : '/') %>"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-indigo-600 transition-colors">
            <i class="ph-bold ph-arrow-left"></i>
            Back to <%= user.role === 'candidate' ? 'Candidate Profile' : (['company', 'recruiter', 'hiring_manager'].includes(user.role) ? 'Company Profile' : 'Dashboard') %>
        </a>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
            <i class="ph-bold ph-shield-check"></i>
            DPDP Act 2023 Compliant
        </span>
    </div>

    <!-- Header Hero Card -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs space-y-3">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-2xl shadow-xs shrink-0">
                <i class="ph-bold ph-shield-star"></i>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-800 tracking-tight">Privacy &amp; Data Protection Center</h1>
                <p class="text-xs text-slate-500">Ministry of Corporate Affairs &bull; Digital Personal Data Protection Act, 2023</p>
            </div>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed pt-2 border-t border-slate-100">
            Under India's <strong>Digital Personal Data Protection Act, 2023 (DPDP Act)</strong>, you have full ownership over your personal data. You have the statutory right to obtain a portable copy of all data held about your account, and the right to permanent erasure of your account and personal records.
        </p>
    </div>

    <!-- Flash Notifications -->
    <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl text-xs font-semibold flex items-center gap-2 shadow-xs">
            <i class="ph-bold ph-check-circle text-emerald-600 text-base"></i>
            <span><%= success_msg %></span>
        </div>
    <% } %>

    <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
        <div class="bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-xl text-xs font-semibold flex items-center gap-2 shadow-xs">
            <i class="ph-bold ph-warning-circle text-rose-600 text-base"></i>
            <span><%= error_msg %></span>
        </div>
    <% } %>

    <!-- SECTION 1: Download My Data (Portability) -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-5">
            <div class="space-y-1">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center text-lg">
                        <i class="ph-bold ph-download-simple"></i>
                    </div>
                    <h2 class="text-lg font-bold text-slate-800">Download My Data</h2>
                </div>
                <p class="text-xs text-slate-500">
                    Export a machine-readable JSON archive containing all personal data, resumes, applications, messages, and settings tied to your account.
                </p>
            </div>
            <a href="/account/privacy/download"
                class="inline-flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs px-5 py-3 rounded-xl transition-all shadow-xs shrink-0 cursor-pointer">
                <i class="ph-bold ph-file-arrow-down text-base"></i>
                Download JSON Archive
            </a>
        </div>

        <!-- Summary of Included Data -->
        <div class="space-y-3">
            <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider">What's Included in Your Export</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                <% if (preview && preview.items) { %>
                    <% preview.items.forEach(item => { %>
                        <div class="p-3 bg-slate-50 border border-slate-100 rounded-xl flex items-center justify-between text-xs">
                            <span class="text-slate-600 font-medium truncate pr-2"><%= item.label %></span>
                            <span class="font-bold text-slate-800 px-2 py-0.5 bg-white border border-slate-200 rounded-md shrink-0">
                                <%= item.count %>
                            </span>
                        </div>
                    <% }) %>
                <% } %>
            </div>
            <p class="text-[11px] text-slate-400 pt-1">
                <i class="ph-bold ph-info text-slate-400"></i> Downloads are encrypted in transit, rate limited to 5 requests per 15 minutes, and logged in the statutory audit log.
            </p>
        </div>
    </div>

    <!-- SECTION 2: Delete My Account (Erasure) -->
    <div class="bg-white border border-rose-200 rounded-2xl p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex items-center gap-3 border-b border-rose-100 pb-5">
            <div class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center text-lg shrink-0">
                <i class="ph-bold ph-trash"></i>
            </div>
            <div>
                <h2 class="text-lg font-bold text-slate-800">Delete My Account</h2>
                <p class="text-xs text-rose-600 font-semibold">Right to Erasure &bull; Permanent and Irreversible Action</p>
            </div>
        </div>

        <!-- Deletion Preview Box -->
        <div class="bg-rose-50/60 border border-rose-200 rounded-xl p-5 space-y-3">
            <div class="flex items-center gap-2 text-rose-800 font-bold text-xs">
                <i class="ph-bold ph-warning text-base text-rose-600"></i>
                <span>Data Scheduled for Permanent Deletion</span>
            </div>
            <p class="text-xs text-rose-700 leading-relaxed">
                If you choose to delete your account, the following items belonging to <strong><%= user.email %></strong> will be permanently purged from our active databases. You will be immediately logged out, and you will not be able to sign in again.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2">
                <% if (preview && preview.items) { %>
                    <% preview.items.forEach(item => { %>
                        <div class="flex items-center justify-between text-xs py-1.5 px-3 bg-white/80 border border-rose-100 rounded-lg text-slate-700">
                            <span class="truncate pr-2 font-medium"><%= item.label %></span>
                            <span class="font-bold text-rose-700"><%= item.count %></span>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>

        <!-- Deletion Blocker Warning (For Company Owners with Live Listings / Team) -->
        <% if (blocker && blocker.blocked) { %>
            <div class="bg-amber-50 border border-amber-300 rounded-xl p-5 space-y-3">
                <div class="flex items-center gap-2 text-amber-900 font-bold text-xs">
                    <i class="ph-bold ph-lock-key text-base text-amber-700"></i>
                    <span>Account Deletion Restricted</span>
                </div>
                <p class="text-xs text-amber-800 leading-relaxed">
                    <%= blocker.message %>
                </p>
                <div class="flex flex-wrap items-center gap-2.5 pt-2">
                    <% if (blocker.reason === 'active_listings') { %>
                        <a href="/company/dashboard"
                            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs transition-colors">
                            <i class="ph-bold ph-briefcase"></i> Manage Listings
                        </a>
                    <% } else if (blocker.reason === 'team_members') { %>
                        <a href="/company/team"
                            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs transition-colors">
                            <i class="ph-bold ph-users-three"></i> Manage Team
                        </a>
                    <% } %>
                </div>
            </div>
        <% } else { %>
            <!-- Deletion Confirmation Form -->
            <form id="deleteAccountForm" action="/account/privacy/delete" method="POST" class="space-y-4 pt-2">
                <div class="space-y-4 bg-slate-50 border border-slate-200 rounded-xl p-5">
                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Confirmation &amp; Verification</h3>

                    <% if (isGoogleAccount) { %>
                        <div class="space-y-1">
                            <label for="confirmEmail" class="block text-xs font-bold text-slate-700">
                                Verify Your Registered Email Address <span class="text-rose-600">*</span>
                            </label>
                            <p class="text-[11px] text-slate-500">
                                Since you use Google single sign-on, confirm by typing your email address: <strong><%= user.email %></strong>
                            </p>
                            <input id="confirmEmail" name="confirmEmail" type="email" required
                                placeholder="<%= user.email %>"
                                class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-rose-500 focus:ring-1 focus:ring-rose-500 bg-white" />
                        </div>
                    <% } else { %>
                        <div class="space-y-1">
                            <label for="password" class="block text-xs font-bold text-slate-700">
                                Current Account Password <span class="text-rose-600">*</span>
                            </label>
                            <input id="password" name="password" type="password" required
                                placeholder="Enter your current password"
                                class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-rose-500 focus:ring-1 focus:ring-rose-500 bg-white" />
                        </div>
                    <% } %>

                    <div class="space-y-1">
                        <label for="confirmation" class="block text-xs font-bold text-slate-700">
                            Type <span class="font-mono text-rose-600 font-black">DELETE</span> to confirm <span class="text-rose-600">*</span>
                        </label>
                        <p class="text-[11px] text-slate-500">Please enter the word "DELETE" in capital letters to confirm.</p>
                        <input id="confirmation" name="confirmation" type="text" required
                            placeholder="DELETE" autocomplete="off"
                            class="w-full text-xs font-mono font-bold px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-rose-500 focus:ring-1 focus:ring-rose-500 bg-white" />
                    </div>

                    <div class="flex items-start gap-2 pt-2">
                        <input id="ackCheckbox" type="checkbox" required
                            class="mt-0.5 rounded text-rose-600 focus:ring-rose-500 border-slate-300" />
                        <label for="ackCheckbox" class="text-xs text-slate-600">
                            I understand that this action is permanent and cannot be undone. All my data will be erased and a confirmation email will be sent to <strong><%= user.email %></strong>.
                        </label>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="submit" id="deleteSubmitBtn"
                        class="inline-flex items-center gap-2 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs px-5 py-3 rounded-xl transition-all shadow-xs cursor-pointer">
                        <i class="ph-bold ph-trash text-base"></i>
                        Permanently Delete My Account
                    </button>
                </div>
            </form>
        <% } %>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('deleteAccountForm');
        if (!form) return;

        form.addEventListener('submit', (e) => {
            const confirmInput = document.getElementById('confirmation');
            if (confirmInput && confirmInput.value.trim() !== 'DELETE') {
                e.preventDefault();
                alert('Please type the word "DELETE" in capital letters to confirm account closure.');
                confirmInput.focus();
                return;
            }

            const ok = window.confirm('Are you absolutely sure you want to delete your account? This action cannot be undone.');
            if (!ok) {
                e.preventDefault();
            }
        });
    });
</script>
